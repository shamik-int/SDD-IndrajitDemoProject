<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: keep app data (Hive boxes, session) out of cloud backup and
     device-to-device transfer (Security Assessment SA-04). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
